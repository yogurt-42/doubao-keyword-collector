# Bind to localhost by default. Do not expose browser sessions directly to the internet.
DOUBAO_HOST=127.0.0.1
DOUBAO_PORT=9090

# Optional. When set, /v1/* endpoints require: Authorization: Bearer <value>
DOUBAO_API_KEY=

# User data is stored outside the source tree by default.
# DOUBAO_DATA_ROOT=C:\Users\you\AppData\Local\DoubaoAccountManager

# Browser options
DOUBAO_HEADLESS=false
DOUBAO_BROWSER_CHANNEL=
DOUBAO_BROWSER_EXECUTABLE_PATH=
DOUBAO_OPEN_ADMIN_BROWSER=true

